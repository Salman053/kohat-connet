{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "models": {
        "llama3.2:3b": {
          "name": "llama3.2:3b",
          "tool_call": false,
          "options": {
            "num_ctx": 4096,
            "num_thread": 6,
            "temperature": 0.3  // Lower temperature = less hallucination
